{
  "id": "builtin.anime.crimson",
  "name": "Багровый раскол",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "Разделённое надвое лицо на тревожно-красном. Тёмные клавиши, жёсткий багровый акцент и голубой блик по краям.",
  "icon": "🎴",
  "backgroundImage": "anime/crimson.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#120C0C",
          "#120C0C"
        ],
        "angle": 90
      },
      "corner": 22
    },
    "colors": {
      "background": "#120C0C",
      "key": "#261B1B",
      "keyText": "#F7E8E8",
      "func": "#1C1414",
      "funcText": "#F7E8E8",
      "accent": "#F5211D",
      "accentText": "#0C0C0C"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#D9261B1B",
        "border": "#3DF5211D",
        "borderWidth": 1,
        "glow": "#1AF5211D",
        "text": "#F7E8E8",
        "pressedBackground": "#F5211D",
        "pressedText": "#0C0C0C",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "material": "solid",
        "background": "#D91C1414",
        "border": "#3DF5211D",
        "text": "#F7E8E8",
        "pressedBackground": "#B84B49",
        "pressedText": "#0C0C0C"
      },
      "space": {
        "border": "#40F5211D",
        "text": "#F7E8E8",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#F5211D",
            "#B84B49"
          ],
          "angle": 0
        },
        "text": "#0C0C0C",
        "glow": "#55F5211D",
        "pressedBackground": "#F7E8E8"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#120C0C",
      "border": "#F5211D",
      "text": "#F7E8E8",
      "pressedBackground": "#F5211D",
      "pressedText": "#0C0C0C"
    },
    "chips": {
      "material": "none",
      "text": "#F7E8E8"
    },
    "buttons": {
      "material": "outline",
      "background": "#B3261B1B",
      "border": "#66F5211D",
      "borderWidth": 1.1,
      "glow": "#20F5211D",
      "text": "#F7E8E8",
      "pressedBackground": "#F5211D"
    },
    "panel": {
      "material": "outline",
      "background": "#E6120C0C",
      "border": "#40F5211D",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
}
