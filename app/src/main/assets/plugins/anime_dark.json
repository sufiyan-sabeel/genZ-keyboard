        "glow": "#1F8B7BFF",
        "text": "#ECEBFF",
        "pressedBackground": "#8B7BFF",
        "pressedText": "#0B0B14",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "background": "#E6171728",
        "border": "#268B7BFF",
        "text": "#CFCBFF",
        "pressedBackground": "#B9AEFF",
        "pressedText": "#0B0B14"
      },
      "space": {
        "border": "#408B7BFF",
        "text": "#ECEBFF",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#8B7BFF",
            "#B9AEFF"
          ],
          "angle": 0
        },
        "text": "#0B0B14",
        "glow": "#668B7BFF",
        "pressedBackground": "#ECEBFF"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#16162A",
      "border": "#8B7BFF",
      "text": "#ECEBFF",
      "pressedBackground": "#8B7BFF",
      "pressedText": "#0B0B14"
    },
    "chips": {
      "material": "none",
      "text": "#D9ECEBFF"
    },
    "buttons": {
      "material": "outline",
      "background": "#0DFFFFFF",
      "border": "#668B7BFF",
      "borderWidth": 1.1,
      "glow": "#268B7BFF",
      "text": "#E6ECEBFF",
      "pressedBackground": "#8B7BFF"
    },
    "panel": {
      "material": "outline",
      "background": "#B316162A",
      "border": "#408B7BFF",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
