{
  "id": "builtin.anime.dark",
  "name": "Аниме: Тёмная",
  "version": "1.0",
  "author": "GenZ Keyboard",
  "description": "Глубокий сине-чёрный фон, мягкие фиолетовые блики и спокойные клавиши. Читается в любой комнате, не отвлекает от текста.",
  "icon": "🌙",
  "backgroundImage": "anime/dark.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#0B0B14",
          "#16162A"
        ],
        "angle": 90
      },
      "orbs": [
        {
          "color": "#2E8B7BFF",
          "x": 0.82,
          "y": 1.05,
          "r": 0.62
        },
        {
          "color": "#1C4B3F8F",
          "x": 0.12,
          "y": -0.08,
          "r": 0.52
        }
      ],
      "trail": "#8B7BFF",
      "corner": 24
    },
    "colors": {
      "background": "#16162A",
      "key": "#1B1B30",
      "keyText": "#ECEBFF",
      "func": "#171728",
      "funcText": "#CFCBFF",
      "accent": "#8B7BFF",
      "accentText": "#0B0B14"
    },
    "keys": {
