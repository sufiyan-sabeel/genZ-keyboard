{
  "id": "builtin.anime.ego",
  "name": "Эго",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "Газетный коллаж: полутон, рваные края и одно огромное слово. Клавиши цвета бумаги со сланцевым акцентом.",
  "icon": "🎴",
  "backgroundImage": "anime/ego.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#DAECF3",
          "#DAECF3"
        ],
        "angle": 90
      },
      "corner": 22
    },
    "colors": {
      "background": "#DAECF3",
      "key": "#F0F9FD",
      "keyText": "#131A1D",
      "func": "#CBDFE7",
      "funcText": "#131A1D",
      "accent": "#243238",
      "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#D9F0F9FD",
        "border": "#30243238",
        "borderWidth": 1,
        "glow": "#1A243238",
        "text": "#131A1D",
        "pressedBackground": "#243238",
        "pressedText": "#FFFFFF",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "material": "solid",
        "background": "#D9CBDFE7",
        "border": "#30243238",
        "text": "#131A1D",
        "pressedBackground": "#5C6C73",
        "pressedText": "#FFFFFF"
      },
      "space": {
        "border": "#40243238",
        "text": "#131A1D",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#243238",
            "#5C6C73"
          ],
          "angle": 0
        },
        "text": "#FFFFFF",
        "glow": "#55243238",
        "pressedBackground": "#131A1D"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#DAECF3",
      "border": "#243238",
      "text": "#131A1D",
      "pressedBackground": "#243238",
      "pressedText": "#FFFFFF"
    },
    "chips": {
      "material": "none",
      "text": "#131A1D"
    },
    "buttons": {
      "material": "outline",
      "background": "#B3F0F9FD",
      "border": "#66243238",
      "borderWidth": 1.1,
      "glow": "#20243238",
      "text": "#131A1D",
      "pressedBackground": "#243238"
    },
    "panel": {
      "material": "outline",
      "background": "#E6DAECF3",
      "border": "#40243238",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
}
