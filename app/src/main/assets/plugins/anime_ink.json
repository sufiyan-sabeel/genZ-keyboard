{
  "id": "builtin.anime.ink",
  "name": "Чернильный демон",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "Чернила и бумага: демон, нарисованный чёрной кистью на тёплой васи. Клавиши — светлая бумага, акцент — сами чернила.",
  "icon": "🎴",
  "backgroundImage": "anime/ink.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#F3E5DA",
          "#F3E5DA"
        ],
        "angle": 90
      },
      "corner": 22
    },
    "colors": {
      "background": "#F3E5DA",
      "key": "#FDF6F0",
      "keyText": "#1D1813",
      "func": "#E7D7CB",
      "funcText": "#1D1813",
      "accent": "#382D24",
      "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#D9FDF6F0",
        "border": "#30382D24",
        "borderWidth": 1,
        "glow": "#1A382D24",
        "text": "#1D1813",
        "pressedBackground": "#382D24",
        "pressedText": "#FFFFFF",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "material": "solid",
        "background": "#D9E7D7CB",
        "border": "#30382D24",
        "text": "#1D1813",
        "pressedBackground": "#73665C",
        "pressedText": "#FFFFFF"
      },
      "space": {
        "border": "#40382D24",
        "text": "#1D1813",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#382D24",
            "#73665C"
          ],
          "angle": 0
        },
        "text": "#FFFFFF",
        "glow": "#55382D24",
        "pressedBackground": "#1D1813"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#F3E5DA",
      "border": "#382D24",
      "text": "#1D1813",
      "pressedBackground": "#382D24",
      "pressedText": "#FFFFFF"
    },
    "chips": {
      "material": "none",
      "text": "#1D1813"
    },
    "buttons": {
      "material": "outline",
      "background": "#B3FDF6F0",
      "border": "#66382D24",
      "borderWidth": 1.1,
      "glow": "#20382D24",
      "text": "#1D1813",
      "pressedBackground": "#382D24"
    },
    "panel": {
      "material": "outline",
      "background": "#E6F3E5DA",
      "border": "#40382D24",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
}
