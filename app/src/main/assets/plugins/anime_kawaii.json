{
  "id": "builtin.anime.kawaii",
  "name": "Кавай: пастель",
  "version": "1.0",
  "author": "GenZ Keyboard",
  "description": "Светлые пастельные клавиши на сливовом фоне: розовый, лаванда и мята. Мягко, но контраст текста сохранён.",
  "icon": "🍭",
  "backgroundImage": "anime/kawaii.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#2B1B30",
          "#3B2440"
        ],
        "angle": 90
      },
      "orbs": [
        {
          "color": "#2EFFC2E0",
          "x": 0.82,
          "y": 1.05,
          "r": 0.62
        },
        {
          "color": "#1CA78BD4",
          "x": 0.12,
          "y": -0.08,
          "r": 0.52
        }
      ],
      "trail": "#FF7AB6",
      "corner": 30
    },
    "colors": {
      "background": "#3B2440",
      "key": "#FFE9F7",
      "keyText": "#4A2B45",
      "func": "#F3D6EA",
      "funcText": "#5E3A56",
      "accent": "#FF7AB6",
      "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "outline",
        "background": "#E6FFE9F7",
        "border": "#3DFF7AB6",
        "borderWidth": 1,
        "glow": "#1FFF7AB6",
        "text": "#4A2B45",
        "pressedBackground": "#FF7AB6",
        "pressedText": "#FFFFFF",
        "press": "jelly",
        "pressScale": 1.04,
        "radius": 18,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "background": "#E6F3D6EA",
        "border": "#26FF7AB6",
        "text": "#5E3A56",
        "pressedBackground": "#FFB3D4",
        "pressedText": "#FFFFFF"
      },
      "space": {
        "border": "#40FF7AB6",
        "text": "#4A2B45",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#FF7AB6",
            "#FFB3D4"
          ],
          "angle": 0
        },
        "text": "#FFFFFF",
        "glow": "#66FF7AB6",
        "pressedBackground": "#4A2B45"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#3B2440",
      "border": "#FF7AB6",
      "text": "#4A2B45",
      "pressedBackground": "#FF7AB6",
      "pressedText": "#FFFFFF"
    },
    "chips": {
      "material": "none",
      "text": "#D94A2B45"
    },
    "buttons": {
      "material": "outline",
      "background": "#0DFFFFFF",
      "border": "#66FF7AB6",
      "borderWidth": 1.1,
      "glow": "#26FF7AB6",
      "text": "#E64A2B45",
      "pressedBackground": "#FF7AB6"
    },
    "panel": {
      "material": "outline",
      "background": "#B33B2440",
      "border": "#40FF7AB6",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
}
