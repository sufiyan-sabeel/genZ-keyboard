{
  "id": "builtin.anime.minimal",
  "name": "Anime Minimal",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "derived: single-surface neutral, no gradient. Palette-only: no artwork is bundled, so the preset renders identically in both flavours.",
  "icon": "◻",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#20232A",
          "#20232A"
        ],
        "angle": 90
      },
      "corner": 20
    },
    "colors": {
      "background": "#20232A",
      "key": "#282C34",
      "keyText": "#D5D9E0",
      "func": "#2E333C",
      "funcText": "#D5D9E0",
      "accent": "#7C8798",
      "accentText": "#12141A"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#282C34",
        "text": "#D5D9E0",
        "radius": 20
      },
      "func": {
        "material": "solid",
        "background": "#2E333C",
        "text": "#D5D9E0",
        "radius": 20
      },
      "enter": {
        "material": "solid",
        "background": "#7C8798",
        "text": "#12141A",
        "radius": 20
      }
    }
  }
}
