{
  "id": "builtin.anime.rose",
  "name": "Красная роза",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "Дождь, вороны и одна красная роза. Монохромная клавиатура ровно с одним красным акцентом.",
  "icon": "🎴",
  "backgroundImage": "anime/rose.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#120C0C",
          "#120C0C"
        ],
        "angle": 90
      },
      "corner": 22
    },
    "colors": {
      "background": "#120C0C",
      "key": "#261B1B",
      "keyText": "#F7E8E9",
      "func": "#1C1414",
      "funcText": "#F7E8E9",
      "accent": "#F51D28",
      "accentText": "#0C0C0C"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#D9261B1B",
        "border": "#3DF51D28",
        "borderWidth": 1,
        "glow": "#1AF51D28",
        "text": "#F7E8E9",
        "pressedBackground": "#F51D28",
        "pressedText": "#0C0C0C",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "material": "solid",
        "background": "#D91C1414",
        "border": "#3DF51D28",
        "text": "#F7E8E9",
        "pressedBackground": "#B8494F",
        "pressedText": "#0C0C0C"
      },
      "space": {
        "border": "#40F51D28",
        "text": "#F7E8E9",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#F51D28",
            "#B8494F"
          ],
          "angle": 0
        },
        "text": "#0C0C0C",
        "glow": "#55F51D28",
        "pressedBackground": "#F7E8E9"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#120C0C",
      "border": "#F51D28",
      "text": "#F7E8E9",
      "pressedBackground": "#F51D28",
      "pressedText": "#0C0C0C"
    },
    "chips": {
      "material": "none",
      "text": "#F7E8E9"
    },
    "buttons": {
      "material": "outline",
      "background": "#B3261B1B",
      "border": "#66F51D28",
      "borderWidth": 1.1,
      "glow": "#20F51D28",
      "text": "#F7E8E9",
      "pressedBackground": "#F51D28"
    },
    "panel": {
      "material": "outline",
      "background": "#E6120C0C",
      "border": "#40F51D28",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
