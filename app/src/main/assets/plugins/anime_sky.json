{
  "id": "builtin.anime.sky",
  "name": "Небо соломенной шляпы",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "Соломенная шляпа на фоне летнего неба. Светлые клавиши, а на Enter — кирпично-красный цвет его рубашки.",
  "icon": "🎴",
  "backgroundImage": "anime/sky.webp",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#F3E2DA",
          "#F3E2DA"
        ],
        "angle": 90
      },
      "corner": 22
    },
    "colors": {
      "background": "#F3E2DA",
      "key": "#FDF4F0",
      "keyText": "#1D1613",
      "func": "#E7D3CB",
      "funcText": "#1D1613",
      "accent": "#B84A1C",
      "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#D9FDF4F0",
        "border": "#30B84A1C",
        "borderWidth": 1,
        "glow": "#1AB84A1C",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF",
        "press": "bounce",
        "pressScale": 1.04,
        "radius": 12,
        "inset": 1.5,
        "hideHint": true
      },
      "func": {
        "material": "solid",
        "background": "#D9E7D3CB",
        "border": "#30B84A1C",
        "text": "#1D1613",
        "pressedBackground": "#DB8763",
        "pressedText": "#FFFFFF"
      },
      "space": {
        "border": "#40B84A1C",
        "text": "#1D1613",
        "fontScale": 0.9
      },
      "enter": {
        "material": "solid",
        "background": {
          "colors": [
            "#B84A1C",
            "#DB8763"
          ],
          "angle": 0
        },
        "text": "#FFFFFF",
        "glow": "#55B84A1C",
        "pressedBackground": "#1D1613"
      },
      "shift": {
        "material": "solid",
        "background": "#F2E7D3CB",
        "border": "#30B84A1C",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF"
      },
      "backspace": {
        "material": "solid",
        "background": "#F2E7D3CB",
        "border": "#30B84A1C",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF"
      },
      "mode": {
        "material": "solid",
        "background": "#F2E7D3CB",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF"
      },
      "globe": {
        "material": "solid",
        "background": "#F2E7D3CB",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF"
      },
      "emoji": {
        "material": "solid",
        "background": "#F2E7D3CB",
        "text": "#1D1613",
        "pressedBackground": "#B84A1C",
        "pressedText": "#FFFFFF"
      },
      "digit": {
        "text": "#1D1613"
      }
    },
    "popup": {
      "radius": 12,
      "background": "#F3E2DA",
      "border": "#B84A1C",
      "text": "#1D1613",
      "pressedBackground": "#B84A1C",
      "pressedText": "#FFFFFF"
    },
    "chips": {
      "material": "solid",
      "background": "#59F3E2DA",
      "border": "#26B84A1C",
      "borderWidth": 1,
      "text": "#1D1613",
      "pressedBackground": "#CCB84A1C",
      "pressedText": "#FFFFFF"
    },
    "buttons": {
      "material": "outline",
      "background": "#B3FDF4F0",
      "border": "#66B84A1C",
      "borderWidth": 1.1,
      "glow": "#20B84A1C",
      "text": "#1D1613",
      "pressedBackground": "#B84A1C"
    },
    "panel": {
      "material": "outline",
      "background": "#E6F3E2DA",
      "border": "#40B84A1C",
      "borderWidth": 1,
      "glow": "#00000000",
      "radius": 20
    }
  }
}
