{
  "id": "builtin.preset.academia",
  "name": "Dark Academia",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "derived: warm paper and ink, low saturation. Palette-only: no artwork is bundled, so the preset renders identically in both flavours.",
  "icon": "📜",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#8E8272",
          "#3B3630"
        ],
        "angle": 90
      },
      "corner": 12
    },
    "colors": {
      "background": "#8E8272",
      "key": "#2E2A26",
      "keyText": "#E8E1D4",
      "func": "#3B3630",
      "funcText": "#E8E1D4",
      "accent": "#A8845C",
      "accentText": "#1A1714"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#2E2A26",
        "text": "#E8E1D4",
        "radius": 12
      },
      "func": {
        "material": "solid",
        "background": "#3B3630",
        "text": "#E8E1D4",
        "radius": 12
      },
      "enter": {
        "material": "solid",
        "background": "#A8845C",
        "text": "#1A1714",
        "radius": 12
      }
    }
  }
}
