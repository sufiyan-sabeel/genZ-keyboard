{
  "id": "builtin.preset.samurai",
  "name": "Samurai Shadow",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "palette from the supplied ink-samurai reference. Palette-only: no artwork is bundled, so the preset renders identically in both flavours.",
  "icon": "🎴",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#B1AA99",
          "#4A4D4F"
        ],
        "angle": 90
      },
      "corner": 14
    },
    "colors": {
      "background": "#B1AA99",
      "key": "#3A3C3E",
      "keyText": "#EDEAE3",
      "func": "#4A4D4F",
      "funcText": "#EDEAE3",
      "accent": "#9E3B3B",
      "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#3A3C3E",
        "text": "#EDEAE3",
        "radius": 14
      },
      "func": {
        "material": "solid",
        "background": "#4A4D4F",
        "text": "#EDEAE3",
        "radius": 14
      },
      "enter": {
        "material": "solid",
        "background": "#9E3B3B",
        "text": "#FFFFFF",
        "radius": 14
      }
    }
