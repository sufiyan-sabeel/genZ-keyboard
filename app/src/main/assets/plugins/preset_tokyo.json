{
  "id": "builtin.preset.tokyo",
  "name": "Midnight Tokyo",
  "version": "2.0",
  "author": "GenZ Keyboard",
  "description": "palette from the supplied rainy-street reference. Palette-only: no artwork is bundled, so the preset renders identically in both flavours.",
  "icon": "🏙",
  "skin": {
    "keyboard": {
      "background": {
        "colors": [
          "#424040",
          "#0D0E0E"
        ],
        "angle": 90
      },
      "corner": 10
    },
    "colors": {
      "background": "#424040",
      "key": "#1A1A1A",
      "keyText": "#D8D8D8",
      "func": "#242424",
      "funcText": "#D8D8D8",
      "accent": "#8C5A3C",
      "accentText": "#F5EDE7"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#1A1A1A",
        "text": "#D8D8D8",
        "radius": 10
      },
      "func": {
        "material": "solid",
        "background": "#242424",
        "text": "#D8D8D8",
        "radius": 10
      },
      "enter": {
        "material": "solid",
        "background": "#8C5A3C",
        "text": "#F5EDE7",
        "radius": 10
      }
    }
  }
}
